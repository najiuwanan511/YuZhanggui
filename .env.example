DB_NAME=yuzhanggui
DB_USERNAME=yuzhanggui
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-root-password
MYSQL_DATA_VOLUME=yuzhanggui-mysql-data
APP_DATA_VOLUME=yuzhanggui-app-data
APP_LOGS_VOLUME=yuzhanggui-app-logs
APP_NETWORK_NAME=yuzhanggui
APP_IMAGE=yuzhanggui:latest
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_EXPIRATION_MS=28800000
ALLOWED_ORIGINS=http://localhost:12400
TRUST_PROXY=false
UPDATE_RELEASE_API=
UPDATE_GITHUB_REPOSITORY=najiuwanan511/YuZhanggui
UPDATE_HOST_DIR=./runtime/update
UPDATE_CHECK_CACHE_MINUTES=60
# Release 直链失败时按顺序使用；留空可禁用备用下载线路。
UPDATE_DOWNLOAD_PROXY_PREFIXES=https://gh-proxy.com/,https://ghfast.top/,https://ghproxy.net/
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JAVA_OPTS=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError
TZ=Asia/Shanghai
CAPTCHA_BROWSER_ENABLED=true
# 桌面部署人工滑块设为 false；无显示器服务器保持 true 并使用手动 Cookie 更新兜底。
CAPTCHA_BROWSER_HEADLESS=true
CAPTCHA_BROWSER_TIMEOUT_SECONDS=120
# 人工通过 VNC 完成滑块时建议设为 600，留出操作时间。
CAPTCHA_BROWSER_MAX_CONCURRENT=1
# 飞牛 OS 远程滑块：启用后打开 http://飞牛IP:7900/vnc.html?autoconnect=true&resize=scale
# 密码最多使用前 8 位；请务必修改默认值，并在启用远程模式时将 headless 交给远程 Xvfb 管理。
CAPTCHA_BROWSER_REMOTE_ENABLED=false
CAPTCHA_BROWSER_REMOTE_PORT=7900
CAPTCHA_BROWSER_REMOTE_BIND=0.0.0.0
CAPTCHA_BROWSER_REMOTE_URL=
CAPTCHA_BROWSER_VNC_PASSWORD=change-me
# 每个账号的浏览器存储状态保存在 app-data 卷，避免验证时反复生成全新设备环境。
CAPTCHA_BROWSER_PROFILE_DIR=./data/browser-profiles
# 默认按需刷新：关闭主动Cookie保活和旧Token扫描。
WEBSOCKET_CREDENTIAL_KEEP_ALIVE_ENABLED=false
WEBSOCKET_CREDENTIAL_REFRESH_MIN_MINUTES=120
WEBSOCKET_CREDENTIAL_REFRESH_MAX_MINUTES=240
WEBSOCKET_TOKEN_REFRESH_SCAN_ENABLED=false
WEBSOCKET_AUTOMATIC_REPAIR_ENABLED=true
WEBSOCKET_AUTOMATIC_REPAIR_MIN_HOURS=2
WEBSOCKET_AUTOMATIC_REPAIR_MAX_HOURS=4
WEBSOCKET_AUTOMATIC_REPAIR_ACCOUNT_SPACING_MINUTES=15
WEBSOCKET_SCHEDULER_POOL_SIZE=16
WEBSOCKET_RECONNECT_DELAY_SECONDS=15
WEBSOCKET_MAX_RECONNECT_DELAY_SECONDS=300
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5
# 可选：当同一公网 IP 频繁检查更新导致 GitHub API 限流时，可填写仅需公开仓库读取权限的 Token。
UPDATE_GITHUB_TOKEN=
RED_FLOWER_INTERVAL_MS=300000
RED_FLOWER_INITIAL_DELAY_MS=90000
RED_FLOWER_LOOKBACK_DAYS=30
RED_FLOWER_BATCH_SIZE=50
